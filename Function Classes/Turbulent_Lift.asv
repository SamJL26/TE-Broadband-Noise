classdef Turbulent_Lift
    methods
        function obj = Turbulent_Lift()
           
        end

        function result = get(obj, theta, alpha, w, azi_mode, SWWN)
            
            kappa_l = (azi_mode /CommonConst.r_blade) * sin(alpha) - CommonConst.get_k0(w) * cos(alpha) * cos(theta);
            tA = obj.thetaA(SWWN);
            tB = obj.thetaB(kappa_l, SWWN);

            result = (exp(2.*1i.*tB) ./ (1i.*tB)) .* ( exp(-2.*1i.*tB) .* sqrt(tA./(tA-tB)) .* erf(sym(sqrt(2.*1i.*(tA-tB)))) - erf(sym(sqrt(2.*1i.*tA))) + 1 );
        end

        function thetaA = thetaA(~, SWWN)
            thetaA = CommonConst.b * (SWWN + CommonConst.get_muainf(SWWN) + CommonConst.get_mua(SWWN) * CommonConst.MX);
        end

        function thetaB = thetaB(~, kappa, SWWN)
            thetaB = CommonConst.b * (abs(SWWN) + abs(kappa));
        end
    end
end