classdef Source_Term_Sqq

    properties
        plate_function = @Willmarth_Roos_Amiet
    end

    methods
        function obj = Source_Term_Sqq()
        end

        function result = get(obj, SWWN)
            result = (1/pi) * obj.lr(SWWN*CommonConst.Uc) * obj.plate_function(SWWN*CommonConst.Uc);
        end

        function lr = lr(obj, w)
            lr = (obj.l2(w) / pi) * (1 / (1 + (obj.l2(w)^2 * CommonConst.kr^2)));
            
        end

        function l2 = l2 (~,w)
            l2 = (CommonConst.xi2 * CommonConst.Uc) / (w);
            disp(CommonConst.Uc) / (w));
            
        end
    end
end