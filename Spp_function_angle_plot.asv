clear

addpath("Flat Plat Models\");
addpath("Function Classes\")

w     = [10*(2*pi)];%,100*(2*pi),10000*(2*pi)];
theta = linspace(0, pi, 50);
alpha = 4*pi/9;

Sqq = Source_Term_Sqq();
Dl  = Polar_Directivity();
Lte = Turbulent_Lift();

spp_result = zeros(length(theta),length(w));

p = polaraxes;
tiledlayout(1,length(w));

for a = 1:length(w)

    for i = 1:length(theta)

        spp_summation = 0;

        for L = 1: length(CommonConst.azi_mode)

            wl  = w(a) + (CommonConst.azi_mode(L) * CommonConst.Omega);

            KXl = wl/CommonConst.Uc;

            spp_summation = spp_summation + ( (Dl.get(theta(i), alpha, w(a), CommonConst.azi_mode(L))) * (Sqq.get(KXl)) * (abs(double(Lte.get(theta(i), alpha, wl,  CommonConst.azi_mode(L), KXl)))^2));
            
        end

        spp_result(i,a) = (CommonConst.B / (2*pi)) * ((CommonConst.get_k0(w(a)) * CommonConst.b) / (CommonConst.r0))^2 * CommonConst.deltar * spp_summation;

    end

    nexttile
    polarplot(theta,10*log10(spp_result(:,a))+153);
    rlim([40 70]);
end
